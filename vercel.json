{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.7.3",
            "config": {
                "installCommand": "composer install --no-dev --optimize-autoloader"
            }
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(css|js|images|fonts)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/favicon.ico",
            "dest": "public/favicon.ico"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "RapidTech",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://rapidtech-web.vercel.app",
        "APP_KEY": "base64:qODzrc6fck74qDMBmiMpOccsWFqiDPQrzpYlHx/VtWg=",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "120",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "VIEW_COMPILED_PATH": "/tmp",
        "FILESYSTEM_DISK": "local",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/tmp/database.sqlite"
    }
}